# ---------------------------------------------------------------------------
# Public (inlined in the static bundle at build time).
# ---------------------------------------------------------------------------

# Origin of the API used by the browser, WITHOUT the /api suffix.
# - Empty  -> same-origin requests to `/api/*` (nginx proxy, Docker, Vercel).
# - Set    -> e.g. `https://api.example.com` for GitHub Pages, which has no
#             backend of its own. The API must then allow the Pages origin
#             through CORS.
NEXT_PUBLIC_API_BASE_URL=

# Base path of the site. Auto-detected on GitHub Actions:
#   `/repository-name` for project pages, `` for user pages or a custom domain.
# Set it explicitly to override, e.g. `/` for a root deployment.
# NEXT_PUBLIC_BASE_PATH=

# Endpoint of the presence server (live cursors).
# Empty -> derived: ws://<host>:3001/ws under `next dev`, otherwise
#          wss://<host>/api/ws behind nginx.
NEXT_PUBLIC_WS_URL=

# ---------------------------------------------------------------------------
# Server-side only (docker compose / the sample API service).
# ---------------------------------------------------------------------------

# Port published by the web container.
WEB_PORT=8080

# Origin allowed to call the API when it is served from another domain
# (GitHub Pages). Comma separated list, `*` is allowed for a quick test.
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
